{"version":1,"domains":[{"id":"files","label":"Archivos","items":[{"id":"open-file","intent":"Abrir un archivo ROOT","aliases":["read root file","open root file","load file","leer archivo","TFile Open"],"python":"import ROOT\nf = ROOT.TFile.Open(\"data.root\")","cpp":"auto* f = TFile::Open(\"data.root\");","details":["PyROOT lanza OSError si el archivo no puede abrirse.","En C++, comprueba !f || f->IsZombie() antes de usarlo."],"docs":"https://root.cern/doc/master/classTFile.html"},{"id":"list-file","intent":"Ver qué contiene","aliases":["inspect file","list keys","ls root file","contents","keys","listar objetos"],"python":"f.ls()","cpp":"f->ls();","docs":"https://root.cern/doc/master/classTFile.html"},{"id":"get-object","intent":"Obtener un objeto por nombre","aliases":["get object","retrieve histogram","read object","key","TDirectory Get"],"python":"h = f[\"h_pt\"]","cpp":"auto* h = f->Get<TH1>(\"h_pt\");","details":["En C++, Get<T>() devuelve nullptr si el nombre o el tipo no coinciden."],"docs":"https://root.cern/doc/master/classTDirectory.html"},{"id":"write-object","intent":"Escribir un objeto","aliases":["save object","write histogram","persist object","WriteObject","guardar objeto"],"python":"with ROOT.TFile(\"out.root\", \"RECREATE\") as f:\n    f.WriteObject(h, \"h_pt\")","cpp":"TFile f{\"out.root\", \"RECREATE\"};\nf.WriteObject(&h, \"h_pt\");","details":["RECREATE reemplaza un archivo existente con el mismo nombre."],"docs":"https://root.cern/doc/master/classTFile.html"},{"id":"close-file","intent":"Cerrar el archivo","aliases":["close file","context manager","cleanup","cerrar TFile"],"python":"f.Close()","cpp":"f->Close();","details":["En Python, usa with ROOT.TFile(...) cuando el objeto solo se necesita dentro de ese bloque."],"docs":"https://root.cern/doc/master/classTFile.html"}]},{"id":"histograms","label":"Histogramas","items":[{"id":"create-histogram","intent":"Crear un histograma 1D","aliases":["create histogram","TH1D","make histogram","histogram bins","crear histograma"],"python":"h = ROOT.TH1D(\"h\", \";p_{T} [GeV];Events\", 50, 0.0, 200.0)","cpp":"TH1D h{\"h\", \";p_{T} [GeV];Events\", 50, 0.0, 200.0};","details":["Firma mental: nombre, título/ejes, N bins, xmin, xmax."],"docs":"https://root.cern/doc/master/classTH1D.html","kata":"problems/cpp-root-histogram.html"},{"id":"fill-histogram","intent":"Llenar el histograma","aliases":["fill histogram","add value","Fill","weighted fill","llenar histograma"],"python":"h.Fill(x)","cpp":"h.Fill(x);","details":["Con peso: h.Fill(x, weight). Fill agrega una observación; no es lo mismo que SetBinContent."],"docs":"https://root.cern/doc/master/classTH1.html","kata":"problems/cpp-root-histogram.html"},{"id":"hist-stats","intent":"Entradas, media y desviación","aliases":["entries","mean","stddev","statistics","summary statistics","estadisticas histograma"],"python":"h.GetEntries()\nh.GetMean()\nh.GetStdDev()","cpp":"h.GetEntries();\nh.GetMean();\nh.GetStdDev();","details":["GetEntries() cuenta fills; no sustituye a Integral() cuando hay pesos o contenidos modificados."],"docs":"https://root.cern/doc/master/classTH1.html"},{"id":"number-bins","intent":"Número de bins","aliases":["number of bins","nbins","GetNbinsX","how many bins","cantidad bins"],"python":"n = h.GetNbinsX()","cpp":"const int n = h.GetNbinsX();","docs":"https://root.cern/doc/master/classTH1.html"},{"id":"inspect-bin","intent":"Inspeccionar un bin","aliases":["bin content","bin error","get bin 4","GetBinContent","GetBinError","contenido bin"],"python":"value = h.GetBinContent(i)\nerror = h.GetBinError(i)","cpp":"const auto value = h.GetBinContent(i);\nconst auto error = h.GetBinError(i);","details":["Numeración: 0 = underflow, 1..N = bins regulares, N+1 = overflow."],"docs":"https://root.cern/doc/master/classTH1.html"},{"id":"hist-integral","intent":"Integral del histograma","aliases":["histogram integral","sum bins","Integral","yield","area histogram"],"python":"total = h.Integral()","cpp":"const auto total = h.Integral();","details":["Integral() usa por defecto los bins regulares. Para incluir under/overflow: Integral(0, h.GetNbinsX() + 1)."],"docs":"https://root.cern/doc/master/classTH1.html"},{"id":"normalize-histogram","intent":"Normalizar el histograma","aliases":["normalize histogram","normalise histogram","unit area","scale integral","Scale","normalizar"],"python":"integral = h.Integral()\nif integral != 0:\n    h.Scale(1.0 / integral)","cpp":"const auto integral = h.Integral();\nif (integral != 0.0) h.Scale(1.0 / integral);","details":["Decide primero si underflow/overflow deben participar en la normalización."],"docs":"https://root.cern/doc/master/classTH1.html"}]},{"id":"rdataframe","label":"RDataFrame","items":[{"id":"rdf-create","intent":"Cargar un TTree como RDataFrame","aliases":["create rdataframe","load tree","read tree","RDataFrame file","dataset"],"python":"df = ROOT.RDataFrame(\"Events\", \"data.root\")","cpp":"ROOT::RDataFrame df{\"Events\", \"data.root\"};","docs":"https://root.cern/manual/data_frame/"},{"id":"rdf-columns","intent":"Ver las columnas disponibles","aliases":["columns","branch names","GetColumnNames","inspect dataframe","available columns"],"python":"columns = list(df.GetColumnNames())","cpp":"const auto columns = df.GetColumnNames();","docs":"https://root.cern/doc/master/classROOT_1_1RDataFrame.html"},{"id":"rdf-define","intent":"Crear una variable derivada","aliases":["define column","derived variable","new column","Define","crear columna","create derived variable"],"python":"df2 = df.Define(\"pt2\", \"pt * pt\")","cpp":"auto df2 = df.Define(\"pt2\", \"pt * pt\");","details":["Define devuelve un nuevo nodo; no modifica df en el sitio."],"docs":"https://root.cern/manual/data_frame/"},{"id":"rdf-filter","intent":"Filtrar eventos","aliases":["filter events","selection","cut","Filter","apply cut","filtrar dataframe"],"python":"selected = df.Filter(\"pt > 25\")","cpp":"auto selected = df.Filter(\"pt > 25\");","details":["Filter también devuelve un nuevo nodo. Las expresiones string usan sintaxis C++."],"docs":"https://root.cern/manual/data_frame/"},{"id":"rdf-count","intent":"Contar eventos","aliases":["count events","Count","how many rows","surviving events","contar eventos"],"python":"count = selected.Count()\nn = count.GetValue()","cpp":"auto count = selected.Count();\nconst auto n = *count;","details":["Count es una acción lazy: el loop se ejecuta cuando pides el resultado."],"docs":"https://root.cern/manual/data_frame/"},{"id":"rdf-histo1d","intent":"Histograma desde RDataFrame","aliases":["Histo1D","histogram dataframe","plot column","book histogram","rdf histogram"],"python":"h = df.Histo1D((\"h\", \";p_{T} [GeV];Events\", 50, 0.0, 200.0), \"pt\")","cpp":"auto h = df.Histo1D({\"h\", \";p_{T} [GeV];Events\", 50, 0.0, 200.0}, \"pt\");","details":["Reserva todas las acciones antes de acceder a sus resultados para que puedan compartir el mismo event loop."],"docs":"https://root.cern/manual/data_frame/"},{"id":"rdf-snapshot","intent":"Guardar eventos seleccionados","aliases":["Snapshot","save dataframe","write skim","filtered root file","guardar selección"],"python":"selected.Snapshot(\"Events\", \"skim.root\", (\"pt\", \"eta\"))","cpp":"selected.Snapshot(\"Events\", \"skim.root\", {\"pt\", \"eta\"});","docs":"https://root.cern/manual/data_frame/"}]},{"id":"trees","label":"Trees / eventos","items":[{"id":"tree-entries","intent":"Número de eventos del TTree","aliases":["tree entries","GetEntries","event count","rows","number of events"],"python":"n = tree.GetEntries()","cpp":"const auto n = tree->GetEntries();","docs":"https://root.cern/doc/master/classTTree.html"},{"id":"tree-print","intent":"Inspeccionar branches y tipos","aliases":["inspect branches","branch list","tree structure","Print tree","schema"],"python":"tree.Print()","cpp":"tree->Print();","docs":"https://root.cern/doc/master/classTTree.html"},{"id":"tree-scan","intent":"Mirar unas pocas filas","aliases":["scan tree","peek events","inspect values","first rows","TTree Scan"],"python":"tree.Scan(\"pt:eta\", \"\", \"\", 5)","cpp":"tree->Scan(\"pt:eta\", \"\", \"\", 5);","details":["Úsalo para inspección rápida, no como patrón de análisis principal."],"docs":"https://root.cern/doc/master/classTTree.html"},{"id":"tree-branch","intent":"Obtener un branch","aliases":["get branch","GetBranch","branch object","find branch"],"python":"branch = tree.GetBranch(\"pt\")","cpp":"auto* branch = tree->GetBranch(\"pt\");","docs":"https://root.cern/doc/master/classTTree.html"},{"id":"tree-to-rdf","intent":"Analizar un TTree con RDataFrame","aliases":["tree to dataframe","modern tree analysis","RDataFrame tree","analyze event data"],"python":"df = ROOT.RDataFrame(tree)","cpp":"ROOT::RDataFrame df{*tree};","details":["Para análisis nuevos, prefiere RDataFrame a escribir un loop manual de branches salvo que necesites control de bajo nivel."],"docs":"https://root.cern/manual/data_frame/"}]},{"id":"fits","label":"Fits","items":[{"id":"fit-gaussian","intent":"Ajustar una Gaussiana","aliases":["fit gaussian","gaus fit","Fit gaus","gaussian peak","ajuste gaussiano"],"python":"fit = h.Fit(\"gaus\", \"S\")","cpp":"auto fit = h.Fit(\"gaus\", \"S\");","details":["La opción S conserva un TFitResult para inspeccionar parámetros, errores y calidad del fit."],"docs":"https://root.cern/doc/master/classTH1.html"},{"id":"fit-range","intent":"Ajustar solo un rango","aliases":["fit range","xmin xmax fit","restricted fit","range gaussian"],"python":"fit = h.Fit(\"gaus\", \"S\", \"\", 80.0, 100.0)","cpp":"auto fit = h.Fit(\"gaus\", \"S\", \"\", 80.0, 100.0);","docs":"https://root.cern/doc/master/classTH1.html"},{"id":"create-tf1","intent":"Crear una función TF1","aliases":["custom function","TF1","model function","fit model","crear funcion"],"python":"f = ROOT.TF1(\"f\", \"[0] + [1]*x\", 0.0, 10.0)","cpp":"TF1 f{\"f\", \"[0] + [1]*x\", 0.0, 10.0};","details":["Los parámetros se referencian como [0], [1], ... dentro de la fórmula."],"docs":"https://root.cern/doc/master/classTF1.html"},{"id":"tf1-parameters","intent":"Inicializar parámetros","aliases":["set parameters","SetParameters","initial guess","fit seed","parameter values"],"python":"f.SetParameters(1.0, 0.0)","cpp":"f.SetParameters(1.0, 0.0);","docs":"https://root.cern/doc/master/classTF1.html"},{"id":"fit-result","intent":"Leer resultado y error del fit","aliases":["fit parameter","fit error","Parameter","ParError","chi2","fit result"],"python":"value = fit.Parameter(0)\nerror = fit.ParError(0)\nchi2 = fit.Chi2()","cpp":"const auto value = fit->Parameter(0);\nconst auto error = fit->ParError(0);\nconst auto chi2 = fit->Chi2();","details":["Necesitas haber ajustado con la opción S para acceder al resultado completo."],"docs":"https://root.cern/doc/master/classTFitResult.html"}]},{"id":"plotting","label":"Plotting / Canvas","items":[{"id":"canvas","intent":"Crear un canvas","aliases":["create canvas","TCanvas","plot window","make canvas"],"python":"c = ROOT.TCanvas(\"c\", \"c\", 800, 600)","cpp":"TCanvas c{\"c\", \"c\", 800, 600};","docs":"https://root.cern/doc/master/classTCanvas.html"},{"id":"draw-hist","intent":"Dibujar un histograma","aliases":["draw histogram","Draw HIST","plot histogram","hist option"],"python":"h.Draw(\"HIST\")","cpp":"h.Draw(\"HIST\");","details":["Opciones comunes: HIST para línea de histograma, E1 para barras de error, SAME para superponer."],"docs":"https://root.cern/doc/master/classTH1.html"},{"id":"draw-errors","intent":"Dibujar con errores","aliases":["error bars","Draw E1","histogram errors","plot errors"],"python":"h.Draw(\"E1\")","cpp":"h.Draw(\"E1\");","docs":"https://root.cern/doc/master/classTH1.html"},{"id":"axis-titles","intent":"Poner títulos a los ejes","aliases":["axis labels","x axis title","y axis title","SetTitle","label axes"],"python":"h.GetXaxis().SetTitle(\"p_{T} [GeV]\")\nh.GetYaxis().SetTitle(\"Events\")","cpp":"h.GetXaxis()->SetTitle(\"p_{T} [GeV]\");\nh.GetYaxis()->SetTitle(\"Events\");","docs":"https://root.cern/doc/master/classTAxis.html"},{"id":"legend","intent":"Añadir una leyenda","aliases":["legend","TLegend","AddEntry","plot label","leyenda"],"python":"leg = ROOT.TLegend(0.65, 0.75, 0.88, 0.88)\nleg.AddEntry(h, \"Data\", \"lep\")\nleg.Draw()","cpp":"TLegend leg{0.65, 0.75, 0.88, 0.88};\nleg.AddEntry(&h, \"Data\", \"lep\");\nleg.Draw();","docs":"https://root.cern/doc/master/classTLegend.html"},{"id":"save-plot","intent":"Guardar el plot","aliases":["save plot","save figure","SaveAs","export pdf","export png","guardar grafico"],"python":"c.SaveAs(\"plot.pdf\")","cpp":"c.SaveAs(\"plot.pdf\");","details":["La extensión decide el formato; por ejemplo .pdf, .png o .svg."],"docs":"https://root.cern/doc/master/classTCanvas.html"}]}]}