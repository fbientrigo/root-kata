# Pinned prebuilt xeus-cpp-lite / CppInterOp WebAssembly artifacts for Gate G7.
#
# These are genuine prebuilt Emscripten binaries (not built from source by us):
# conda packages published on the emscripten-forge-4x channel (prefix.dev),
# built by the compiler-research project's own CI from clang-repl + CppInterOp.
#
# Package provenance (from https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32/repodata.json):
#   xeus-cpp   0.10.0  h0b0027f_0  -> bin/xcpp.js, bin/xcpp.wasm, bin/xcpp.data
#                                     (the interpreter kernel executable: clang-repl driven
#                                      by CppInterOp, exported via embind as `xkernel`)
#   cppinterop 1.9.0   h0b0027f_0  -> lib/libclangCppInterOp.so.21.1
#                                     (Clang/LLVM 21.1.8 wrapped as a wasm dynamic library;
#                                      dlopen'd by xcpp.wasm at startup via its dylink.0 section)
#   xeus       6.0.5   h0b0027f_0  -> lib/libxeus.so
#                                     (the other wasm dynamic library xcpp.wasm dlopens)
#
# Do not edit these values without re-verifying both the URL and the sha256 (taken
# directly from the channel's own repodata.json "sha256" field for each package).

XCPP_CHANNEL_BASE="https://repo.prefix.dev/emscripten-forge-4x/emscripten-wasm32"

XEUS_CPP_PKG="xeus-cpp-0.10.0-h0b0027f_0.tar.bz2"
XEUS_CPP_SHA256="de269a95d4e5cca9840615db5c231823017f237435d32f523b943118c205c046"

CPPINTEROP_PKG="cppinterop-1.9.0-h0b0027f_0.tar.bz2"
CPPINTEROP_SHA256="ee1433b4e7e218391a59b79a4b0a9355fb38b42daef7f3df78974cf5b56d7823"

XEUS_PKG="xeus-6.0.5-h0b0027f_0.tar.bz2"
XEUS_SHA256="cb01edb59b5627f892902a05a5abe6b2ef56e6ab0e2032e8b5180bd453f07998"
